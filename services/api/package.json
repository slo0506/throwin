{
  "name": "@throwin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@throwin/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@supabase/supabase-js": "2.117.2",
    "@throwin/shared": "workspace:*",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
