# Copy to .env for local development. Never commit real values.
# throwin-dev. Use http://127.0.0.1:54321 for a local Supabase stack.
SUPABASE_URL=https://uhxzajdmerqubbkqhlxe.supabase.co
SUPABASE_ANON_KEY=
# Server only. Bypasses RLS, so every query in the API is scoped by user ID.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret (Supabase dashboard > Project Settings > JWT Keys).
SUPABASE_JWT_SECRET=
# Optional. Set for projects using asymmetric signing keys, e.g.
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://uhxzajdmerqubbkqhlxe.supabase.co/auth/v1/.well-known/jwks.json
PORT=8787
# off | log | enforce
APP_ATTEST_MODE=off
LOG_LEVEL=info
# The GM (/v1/gm/*). Without a key those routes answer 503 and everything else works.
ANTHROPIC_API_KEY=
# Optional. Folder with system.md and skills/. Defaults to the nearest agents/gm above the cwd.
GM_PROMPT_DIR=
# GM spend caps in cents per rolling 24 hours: per person, and everyone together.
GM_USER_DAILY_BUDGET_CENTS=300
GM_DAILY_BUDGET_CENTS=1000
