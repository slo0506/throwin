# Copy to .env for local development. Never commit real values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server only. Bypasses RLS, so every query in the API is scoped by user ID.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret (Supabase dashboard > Project Settings > JWT Keys).
SUPABASE_JWT_SECRET=
# Optional. Set for projects using asymmetric signing keys, e.g.
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
PORT=8787
# off | log | enforce
APP_ATTEST_MODE=off
LOG_LEVEL=info
