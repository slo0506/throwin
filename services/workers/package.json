{
  "name": "@throwin/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./eval": {
      "@throwin/source": "./src/eval-exports.ts",
      "types": "./dist/eval-exports.d.ts",
      "default": "./dist/eval-exports.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @throwin/shared build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --conditions=@throwin/source src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/supabase-js": "2.117.2",
    "@throwin/shared": "workspace:*",
    "sharp": "^0.35.5",
    "zod": "4.6.5"
  }
}
